# Copie para .env na raiz (nunca commite o .env)
N8N_HOST=https://seu-n8n.exemplo.com
WEBHOOK_ID=seu-uuid-do-webhook
# test = webhook-test (local/editor) | prod = webhook (workflow publicado)
WEBHOOK_MODE=test
# tempo máximo esperando relatório (ms) — 900000 = 15 min
FETCH_TIMEOUT_MS=900000

# Depois rode: node scripts/generate-config.js
# Isso cria js/config.js (também ignorado pelo Git).
#
# GitHub Pages: use o workflow .github/workflows/deploy-pages.yml
# Secrets do repositório (Settings → Secrets → Actions):
#   N8N_HOST, WEBHOOK_ID
# O CI gera js/config.js só no artefato publicado (não vai no git).
#
# Nota: quem usa o site ainda vê a URL no DevTools (rede).
# O segredo real deve ficar no n8n (auth no webhook); isso só tira do repositório.
