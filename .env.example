# Copie para .env na raiz (nunca commite o .env)
N8N_HOST=https://seu-n8n.exemplo.com
WEBHOOK_ID=seu-uuid-do-webhook
# test = webhook-test (local/editor) | prod = webhook (workflow publicado)
WEBHOOK_MODE=test
# tempo máximo esperando relatório (ms) — 900000 = 15 min
FETCH_TIMEOUT_MS=900000

# Depois rode (pasta local, não versionada): node scripts/generate-config.js
# Cria js/config.js (local) e js/runtime-config.js.
#
# Evolution API (WhatsApp — nó no n8n, não no front):
# EVOLUTION_API_URL=https://evolution.telfercompany.com.br
# EVOLUTION_INSTANCE=Telfer.co
# EVOLUTION_API_KEY=<token DA INSTÂNCIA Telfer.co — não use a global>
# PAINEL_URL=https://gamesferabr.github.io/telfer-performance-intelligence/preview/
#
# Grupo de testes TCO (instância Telfer.co):
#   Nome: TCO: Testes Mensagens Tom
#   JID:  120363409488905739@g.us
#
# Listar JID dos grupos WhatsApp:
#   node ferramentas-n8n/evolution-listar-grupos.js SUA_API_KEY "Testes Mensagens"
#
# GitHub Pages (recomendado): Settings → Pages → Source = GitHub Actions
# Secrets: N8N_HOST, WEBHOOK_ID — workflow deploy-pages.yml
# Se Pages estiver em "branch main", js/runtime-config.js no git precisa estar atualizado.
#
# Nota: quem usa o site ainda vê a URL no DevTools (rede).
# O segredo real deve ficar no n8n (auth no webhook); isso só tira do repositório.
